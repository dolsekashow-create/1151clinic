{
  "name": "@erp/root",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise Multi-Branch Management Platform",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "test:rls": "node --test --test-reporter=spec supabase/tests/rls.test.mjs supabase/tests/users.test.mjs supabase/tests/appointments.test.mjs supabase/tests/admin.test.mjs supabase/tests/public-booking.test.mjs",
    "test:all": "pnpm test && pnpm test:rls",
    "db:seed:generate": "node scripts/generate-seed.mjs",
    "db:types:generate": "node scripts/generate-db-types.mjs",
    "db:types": "supabase gen types typescript --local > packages/types/src/database.types.ts",
    "db:reset": "supabase db reset",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:push": "supabase db push",
    "demo:plan": "node scripts/seed-demo.mjs --dry-run",
    "demo:seed": "node scripts/seed-demo.mjs --confirm",
    "demo:verify": "node scripts/verify-demo.mjs",
    "demo:verify:public": "node scripts/verify-publishing.mjs",
    "demo:verify:users": "node scripts/verify-users.mjs",
    "demo:verify:appointments": "node scripts/verify-appointments.mjs",
    "demo:verify:admin": "node scripts/verify-admin.mjs",
    "demo:verify:booking": "node scripts/verify-booking.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "embedded-postgres": "18.4.0-beta.17",
    "pg": "^8.23.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "supabase": "^2.114.0",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
