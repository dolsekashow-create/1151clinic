# =============================================================================
#  Enterprise Multi-Branch Platform — Environment Template
# =============================================================================
#  انسخ هذا الملف إلى:
#     .env.local        → للتطوير المحلي (development)
#     .env.staging      → لبيئة الاختبار (staging)
#     .env.production   → للإنتاج (production)  ← تُدار من Vercel Environment Variables
#
#  ⚠️  ممنوع منعًا باتًا وضع أي Secret حقيقي في هذا الملف أو رفعه إلى Git.
#  ⚠️  أي متغير يبدأ بـ NEXT_PUBLIC_ يصل إلى المتصفح — لا تضع فيه أسرارًا.
# =============================================================================

# -----------------------------------------------------------------------------
# 1) Application
# -----------------------------------------------------------------------------
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_URL=

# -----------------------------------------------------------------------------
# 2) Supabase — Public (client + server)
# -----------------------------------------------------------------------------
#  العنوان يُشتق من Project Ref حسب اصطلاح Supabase الرسمي:
#     https://<project-ref>.supabase.co
#  المصدر الرسمي: Supabase Dashboard ← Project Settings ← Data API ← Project URL
NEXT_PUBLIC_SUPABASE_URL=

#  Publishable key بصيغة: sb_publishable_...
#  عام بحكم التصميم؛ الحماية الفعلية من RLS وليست من إخفاء المفتاح.
#  المصدر: Project Settings ← API Keys ← Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# 3) Supabase — Server ONLY  (يتجاوز RLS — لا يُستخدم إلا في مسارات موثوقة)
# -----------------------------------------------------------------------------
#  Secret key بصيغة: sb_secret_...
#  ⛔ ممنوع استيراده في أي ملف يحتوي "use client".
#  اختياري: النظام يعمل كاملًا بدونه؛ غيابه يعطّل العمليات الإدارية فقط.
SUPABASE_SECRET_KEY=

#  سلسلة اتصال مباشرة بـ Postgres (للـ migrations والأدوات فقط — ليست للتطبيق)
# DATABASE_URL=

# -----------------------------------------------------------------------------
# 4) Notifications — Providers  (Phase 5)
# -----------------------------------------------------------------------------
# REQUIREMENT_PENDING: مزود الـ SMS لم يُعتمد بعد من الإدارة (راجع Q-19).
# القيم المدعومة حاليًا: console (تسجيل فقط) | noop
NOTIFICATIONS_SMS_PROVIDER=console
NOTIFICATIONS_SMS_SENDER_ID=
NOTIFICATIONS_EMAIL_PROVIDER=console

# -----------------------------------------------------------------------------
# 5) Legacy System Integration  (لم يُحدد بعد — راجع Q-17)
# -----------------------------------------------------------------------------
LEGACY_INTEGRATION_ENABLED=false
LEGACY_API_BASE_URL=
LEGACY_API_KEY=

# -----------------------------------------------------------------------------
# 6) Security / Operations
# -----------------------------------------------------------------------------
# مفتاح تحقق للـ webhooks/cron الداخلية (سلسلة عشوائية طويلة ≥ 16 حرفًا)
INTERNAL_WEBHOOK_SECRET=
RATE_LIMIT_ENABLED=true
