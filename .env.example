# =============================================================================
#  Enterprise Multi-Branch Platform — Environment Template
# =============================================================================
#  انسخ هذا الملف إلى:
#     .env.local        → للتطوير المحلي (development)
#     .env.staging      → لبيئة الاختبار (staging)
#     .env.production   → للإنتاج (production)  ← تُدار من Vercel Environment Variables
#
#  ⚠️  ممنوع منعًا باتًا وضع أي Secret حقيقي في هذا الملف أو رفعه إلى Git.
#  ⚠️  أي متغير يبدأ بـ NEXT_PUBLIC_ يصل إلى المتصفح — لا تضع فيه أسرارًا.
# =============================================================================

# -----------------------------------------------------------------------------
# 1) Application
# -----------------------------------------------------------------------------
# البيئة المنطقية للتطبيق: development | staging | production
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME="النظام المركزي لإدارة الفروع"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 2) Supabase — Public (client + server)
# -----------------------------------------------------------------------------
# القيم المحلية الافتراضية عند تشغيل `supabase start`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_LOCAL_ANON_KEY

# -----------------------------------------------------------------------------
# 3) Supabase — Server ONLY  (يتجاوز RLS — لا يُستخدم إلا في مسارات موثوقة)
# -----------------------------------------------------------------------------
# يُمنع استيراد هذا المتغير في أي ملف يحتوي "use client".
# يُستخدم فقط في: seeding / admin tasks / webhooks موقّعة / background jobs.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY

# سلسلة اتصال مباشرة بـ Postgres (للـ migrations والأدوات فقط — ليست للتطبيق)
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# -----------------------------------------------------------------------------
# 4) Notifications — Providers  (Phase 5)
# -----------------------------------------------------------------------------
# REQUIREMENT_PENDING: مزود الـ SMS لم يُعتمد بعد من الإدارة.
# الطبقة البرمجية تدعم: console (تطوير) | <provider-name> (لاحقًا)
NOTIFICATIONS_SMS_PROVIDER=console
NOTIFICATIONS_SMS_SENDER_ID=
NOTIFICATIONS_SMS_API_BASE_URL=
NOTIFICATIONS_SMS_API_KEY=
NOTIFICATIONS_SMS_API_SECRET=

NOTIFICATIONS_EMAIL_PROVIDER=console
NOTIFICATIONS_EMAIL_FROM=

# -----------------------------------------------------------------------------
# 5) Legacy System Integration  (Phase 8+ — لم يُحدد بعد)
# -----------------------------------------------------------------------------
# REQUIREMENT_PENDING: لا نعرف بعد نوع النظام القديم ولا طريقة التكامل.
LEGACY_INTEGRATION_ENABLED=false
LEGACY_API_BASE_URL=
LEGACY_API_KEY=

# -----------------------------------------------------------------------------
# 6) Security / Operations
# -----------------------------------------------------------------------------
# مفتاح تحقق للـ webhooks/cron الداخلية (سلسلة عشوائية طويلة)
INTERNAL_WEBHOOK_SECRET=
# تفعيل الـ rate limiting على مسارات المصادقة والعمليات الحساسة
RATE_LIMIT_ENABLED=true
